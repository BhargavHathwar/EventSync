# EventSync Configuration

# Server Port (default 3000)
PORT=3000

# ----------------------------------------------------
# Database Configuration
# ----------------------------------------------------
# EventSync supports PostgreSQL and zero-config SQLite.
#
# Option A: PostgreSQL (Production / Cloud / Local Postgres)
# Provide your PostgreSQL connection URI below:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/eventsync
#
# Examples:
# - Local PostgreSQL:
#   DATABASE_URL=postgresql://postgres:your_password@localhost:5432/eventsync
#
# - Cloud PostgreSQL (Supabase / Neon / Railway / Render / AWS RDS):
#   DATABASE_URL=postgresql://user:password@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require
#   DATABASE_SSL=true
#
# Option B: SQLite (Default / Local Offline Development)
# If DATABASE_URL is left unset or commented out, EventSync automatically
# defaults to embedded SQLite (stored at data/eventsync.db) with WAL mode,
# requiring zero external setup or database server installation.
# DATABASE_PATH=data/eventsync.db
